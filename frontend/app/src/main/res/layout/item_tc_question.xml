<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_tc_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <TextView
        android:id="@+id/tcQNumber"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/bg_t_pill"
        android:backgroundTint="@color/t_chip_bg"
        android:gravity="center"
        android:textColor="@color/ts_muted"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tcQText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/t_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tcQMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/ts_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnQEdit"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_t_pill"
        android:backgroundTint="@color/t_indigo_soft"
        android:gravity="center"
        android:text="✎"
        android:textColor="@color/t_indigo" />

    <TextView
        android:id="@+id/btnQDelete"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_t_pill"
        android:backgroundTint="@color/tc_red_soft"
        android:gravity="center"
        android:text="🗑"
        android:textColor="@color/tc_red" />
</LinearLayout>