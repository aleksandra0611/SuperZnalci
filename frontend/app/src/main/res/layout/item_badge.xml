<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="@drawable/bg_card"
    android:elevation="1dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="14dp">

    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp">

        <FrameLayout
            android:id="@+id/badgeCircle"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_circle_solid">

            <TextView
                android:id="@+id/tvBadgeGlyph"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/ivBadgeIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </FrameLayout>

        <ImageView
            android:id="@+id/ivBadgeCheck"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_day_done"
            android:importantForAccessibility="no"
            android:padding="4dp"
            android:src="@drawable/ic_check_white" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvBadgeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="@color/on_surface"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvBadgeDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:textColor="@color/on_surface_muted"
        android:textSize="12sp" />
</LinearLayout>
