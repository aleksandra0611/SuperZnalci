<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="3dp"
    android:layout_weight="1"
    android:background="@drawable/bg_tc_field"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/tlBadgeIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_t_pill"
        android:gravity="center"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tlBadgeName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="@color/t_text"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tlBadgeSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/ts_muted"
        android:textSize="10sp" />
</LinearLayout>