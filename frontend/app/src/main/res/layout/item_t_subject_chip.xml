<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_t_pill"
    android:backgroundTint="@color/t_chip_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp">

    <View
        android:id="@+id/chipDot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/bg_t_oval"
        android:backgroundTint="@color/t_green" />

    <TextView
        android:id="@+id/chipName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/t_text"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/chipModules"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/t_muted"
        android:textSize="12sp" />
</LinearLayout>
